# Client site environment variables (copy to .env for local development)

# Projects API (proxied via Netlify functions in production)
VITE_GET_PROJECTS=/api/projects

# Portal base URL for checkout redirects
VITE_PORTAL_URL=http://localhost:3000

# EmailJS contact form
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Netlify function server-side vars (not exposed to browser)
RAILS_API_URL=http://localhost:3000
RAILS_API_KEY=change-this-local-api-key
